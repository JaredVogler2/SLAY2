  "simulatorGaps": [
    {
      "id": "G1-double-boss-not-entered",
      "min_ascension": 10,
      "affects": "results",
      "summary": "A10 Double Boss is not modelled: the second Act-3 boss is rolled but the map has no second boss point and the run is won after the first boss (game: StandardActMap.SecondBossMapPoint, one row above the boss). Simulator A10 win rates are therefore NOT Double Boss win rates."
    },
    {
      "id": "G2-a8-hp-scaling",
      "min_ascension": 8,
      "affects": "coverage",
      "summary": "Living Shield, Scroll of Biting and The Merchant??? ignore the A8 HP increase (97 of 100 audited enemy rows match)."
    },
    {
      "id": "G3-sovereign-blade-crash",
      "min_ascension": 0,
      "affects": "coverage",
      "summary": "is_sovereign_blade(None) raises in rare power/attack interactions (~1 in 2,000 random games); such games are reported as simulator_error and excluded from win rates."
    },
    {
      "id": "G4-rng-family",
      "min_ascension": 0,
      "affects": "results",
      "summary": "The simulator ports .NET System.Random; the game uses xoshiro256** (v0.107.1). Distributions match where audited, but no seed reproduces a live run and per-card roll order differs."
    },
    {
      "id": "G5-no-live-parity",
      "min_ascension": 0,
      "affects": "results",
      "summary": "State transitions have not been compared with a live STS2 build (no owned game in this environment)."
    },
    {
      "id": "G6-undefined-name-in-reward-roll",
      "min_ascension": 0,
      "affects": "coverage",
      "summary": "A reward path calls `_roll_random_relic_rewards`, a name the pinned simulator never defines (NameError): 2 of 2,000 rules_v1 validation games ended as simulator_error and are excluded from win rates, never counted as losses."
    },
    {
      "id": "G7-no-legal-actions",
      "min_ascension": 0,
      "affects": "coverage",
      "summary": "In 1 of 2,000 rules_v1 validation games the run was not over but the simulator offered no legal action; the episode is reported as simulator_error and excluded from win rates."
    },
    {
      "id": "G8-dragon-fruit-lucky-fysh-shop",
      "min_ascension": 0,
      "affects": "coverage",
      "summary": "Buying a card in a shop while holding Lucky Fysh (+15 gold per card added) and Dragon Fruit (max HP on gold gained) raises `TypeError: unhashable type: 'PlayerState'` in the pinned simulator (Dragon Fruit's gold handler looks the owner up in a dict keyed by creature). Seen in 1 of 2,000 rules_v1 Silent validation games (seed 605866524, Act 2); the episode is reported as simulator_error and excluded from win rates and paired comparisons."
    },
    {
      "id": "G9-particle-wall-loop",
      "min_ascension": 0,
      "affects": "coverage",
      "summary": "Regent's Particle Wall (catalog: 0 energy and 2 stars; gains block and returns to hand) is offered again at cost 0 after every play in the pinned simulator, and the rules policies keep playing it: 33 of 5,000 Regent exploration games (0.66 %) reached the 20,000-step limit with block in the hundreds of thousands. Such games end as timeout, are excluded from card values and paired comparisons and are never read as losses. Whether the simulator charges the stars was not examined; the policies have no guard against replaying a card that returns to hand."
    }
  ],
