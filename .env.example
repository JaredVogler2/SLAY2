# Copy to .env.local for local development. Never commit real secrets (the pre-commit guard rejects .env files).
# The website needs no secrets: it is client-first and stores user state in the browser only.
NEXT_TELEMETRY_DISABLED=1
# Public canonical URL once a real deployment exists (used for metadata only). Leave empty until verified.
NEXT_PUBLIC_SITE_URL=
# Optional public contact link shown on /about ("Found a mistake?"). https: or mailto: only; anything else is ignored.
NEXT_PUBLIC_CONTACT_URL=
