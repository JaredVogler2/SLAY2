  "provenance": {
    "kind": "SLAY2's own judgement of how cards work together, written from reading each card's effect in a local, pinned, git-ignored reference (ADR-011); no card text, art or numbers are stored",
    "reading": "g = what the card provides to the deck, per mechanic: 1 minor or conditional, 2 standard, 3 major or repeatable; w = how much of the card's value depends on the mechanic: 1 a bonus, 2 significant, 3 the card's point; a negative g takes the mechanic away. Mechanics counted from card types, costs and names (attack, skill, power, cheap, zero_cost, strike), from the Exhaust keyword and from the block role are added by the code, not listed here.",
    "sources": [
      {
        "id": "spire-archive",
        "sha": "4e6b0e040ccd00eb04fb1ab7fb0b298c222d2f29",
        "gameVersion": "0.107.1",
        "used": "each card's effect, read to decide the tags; nothing is copied"
      }
    ],
    "retrieved": "2026-10-26",
    "notAMeasurement": "The tags and weights are judgements about mechanics. Whether they carry signal in simulated runs is tested separately (docs/DECISIONS.md, ADR-050)."
  },
  "mechanics": {
    "strength": {
      "label": "Strength",
      "k": 2,
      "engine": 4,
      "about": "Strength adds damage to every hit of every attack; it is worth most to cards that hit several times."
    },
    "dexterity": {
      "label": "Dexterity",
      "k": 2,
      "engine": 0,
      "about": "Dexterity adds Block to every card that gives Block."
    },
    "block": {
      "label": "Block",
      "k": 12,
      "engine": 3,
      "about": "Block gained from cards; a few cards turn the amount of Block (or keeping it) into damage or defence."
    },
    "exhaust": {
      "label": "Exhaust",
      "k": 3,
      "engine": 6,
      "about": "Cards that exhaust cards (their own or others); payoffs trigger on each exhausted card."
    },
    "draw": {
      "label": "Card draw",
      "k": 5,
      "engine": 4,
      "about": "Drawing many cards; payoffs count cards drawn or reward a large hand."
    },
    "energy": {
      "label": "Energy",
      "k": 2,
      "engine": 3,
      "about": "Extra energy; most useful to expensive cards and cards that spend all your energy (X cost)."
    },
    "vulnerable": {
      "label": "Vulnerable",
      "k": 3,
      "engine": 4,
      "about": "Applying Vulnerable; payoffs punish or exploit it."
    },
    "weak": {
      "label": "Weak",
      "k": 3,
      "engine": 4,
      "about": "Applying Weak; payoffs reward debuffs on the enemy."
    },
    "poison": {
      "label": "Poison",
      "k": 3,
      "engine": 6,
      "about": "Applying Poison; payoffs multiply, trigger or convert it."
    },
    "shiv": {
      "label": "Shivs",
      "k": 4,
      "engine": 6,
      "about": "Making Shivs; payoffs make each Shiv hit harder or use the ones you made."
    },
    "discard": {
      "label": "Discarding",
      "k": 3,
      "engine": 6,
      "about": "Discarding cards from your hand; Sly cards and discard payoffs want it."
    },
    "orb": {
      "label": "Orbs",
      "k": 3,
      "engine": 6,
      "about": "Channeling orbs; payoffs scale with the orbs you hold, their types, or evoke them."
    },
    "focus": {
      "label": "Focus",
      "k": 2,
      "engine": 0,
      "about": "Focus strengthens every orb's passive and evoke."
    },
    "star": {
      "label": "Stars",
      "k": 3,
      "engine": 6,
      "about": "Gaining Stars; cards that cost Stars, and Star payoffs, need a steady supply."
    },
    "forge": {
      "label": "Forge",
      "k": 3,
      "engine": 6,
      "about": "Forging the Sovereign Blade; cards that change what the blade does want it forged."
    },
    "create": {
      "label": "Card creation",
      "k": 3,
      "engine": 5,
      "about": "Creating cards in combat; payoffs trigger on each card you create."
    },
    "osty": {
      "label": "Osty",
      "k": 3,
      "engine": 6,
      "about": "Summoning and healing Osty; Osty's attacks and Osty payoffs need him alive and strong."
    },
    "soul": {
      "label": "Souls",
      "k": 3,
      "engine": 6,
      "about": "Adding Souls to your piles; payoffs trigger when you play or exhaust them."
    },
    "doom": {
      "label": "Doom",
      "k": 3,
      "engine": 6,
      "about": "Applying Doom; payoffs convert or exploit the Doom on an enemy."
    },
    "ethereal": {
